{
  "name": "sunnysideup/spring-clean-recipe",
  "description": "This silverstripe module removes old versions, unused files, elementals that are not requires, files that are not in use, and more.",
  "type": "silverstripe-recipe",
  "keywords": [
    "versioned",
    "remove",
    "clean",
    "spring clean",
    "assets",
    "obsolete",
    "no longer needed",
    "dev tools",
    "speed",
    "reduce size"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "silverstripe/framework": "^5.0",
    "silverstripe/admin": "^2.0",
    "sunnysideup/silverstripe-garbage-collector": "5.x-dev",
    "sunnysideup/silverstripe-unused-file-report": "5.x-dev",
    "sunnysideup/assets_overview": "5.x-dev",
    "sunnysideup/remove-orphaned-elementals": "5.x-dev",
    "sunnysideup/cleanup-tables": "5.x-dev",
    "sunnysideup/database-share-clean-up": "5.x-dev",
    "sunnysideup/dataintegritytests": "5.x-dev",
    "sunnysideup/delete-all-tables": "5.x-dev",
    "sunnysideup/templateoverview": "5.x-dev",
    "sunnysideup/resize-all-images": "5.x-dev",
    "sunnysideup/version-pruner": "5.x-dev",
    "oddnoc/silverstripe-artefactcleaner": "5.x-dev"
  },
  "require-dev": {
    "silverleague/ideannotator": "*",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.7",
    "silverstripe/standards": "^1",
    "phpstan/extension-installer": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "Sunnysideup\\SpringCleanRecipe\\": "src/"
    }
  },
  "extra": {
    "expose": [
      "client/dist"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "bin": [],
  "authors": [
    {
      "name": "Nicolaas Thiemen Francken",
      "email": "modules@sunnysideup.co.nz",
      "role": "lead developer"
    },
    "repositories": [
        {
          "type": "vcs",
          "url": "git@github.com:sunnysideup/silverstripe-artefactcleaner.git"
        }
    ]
  ]
}
