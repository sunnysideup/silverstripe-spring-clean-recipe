{
  "name": "sunnysideup/spring-clean-recipe",
  "description": "This silverstripe module removes old versions, unused files, elementals that are not requires, files that are not in use, and more.",
  "type": "silverstripe-recipe",
  "keywords": [
    "versioned",
    "remove",
    "clean",
    "spring clean",
    "assets",
    "obsolete",
    "no longer needed",
    "dev tools",
    "speed",
    "reduce size"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "silverstripe/framework": "^6.0",
    "silverstripe/admin": "^3.0",
    "sunnysideup/silverstripe-garbage-collector": "dev-main",
    "sunnysideup/silverstripe-unused-file-report": "dev-main",
    "sunnysideup/assets_overview": "dev-main",
    "sunnysideup/remove-orphaned-elementals": "dev-main",
    "sunnysideup/cleanup-tables": "dev-main",
    "sunnysideup/database-share-clean-up": "dev-main",
    "sunnysideup/dataintegritytests": "dev-main",
    "sunnysideup/delete-all-tables": "dev-main",
    "sunnysideup/templateoverview": "dev-main",
    "sunnysideup/resize-all-images": "dev-main",
    "sunnysideup/version-pruner": "dev-main",
    "oddnoc/silverstripe-artefactcleaner": "dev-main"

  },
  "require-dev": {
  },
  "autoload": {
    "psr-4": {
      "Sunnysideup\\SpringCleanRecipe\\": "src/"
    }
  },
  "extra": {
    "expose": [
      "client/dist"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "bin": [],
  "authors": [
    {
      "name": "Nicolaas Thiemen Francken",
      "email": "modules@sunnysideup.co.nz",
      "role": "lead developer"
    }
  ]
}
